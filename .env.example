# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Supabase Project URL
# Get from: Supabase Dashboard  Settings  API  Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Public Key)
# Get from: Supabase Dashboard  Settings  API  anon public key
# This is safe to expose in client-side code
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side only - DO NOT expose in client)
# Get from: Supabase Dashboard  Settings  API  service_role key
# Only used for server-side admin operations (payments, orders, etc.)
#  SECURITY: Never commit this key or expose it in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
